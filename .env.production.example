APP_NAME="360inmystore"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://g-stock.maxisujets.net

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Créer la base et l'utilisateur MySQL dans cPanel > Bases de données MySQL.
# cPanel préfixe généralement le nom de la base et de l'utilisateur par le nom
# du compte d'hébergement (ex. moncompte_360inmystore).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Aucun job n'est mis en file d'attente dans l'application (envois de
# notifications/e-mails synchrones, par choix). "sync" exécute tout
# immédiatement dans la requête — indispensable ici : l'hébergement mutualisé
# n'a pas de worker de queue persistant (pas de Supervisor).
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

# SMTP réel requis en production (les identifiants de connexion des nouveaux
# utilisateurs sont envoyés par e-mail). "log" écrirait les e-mails dans les
# logs au lieu de les envoyer — à ne jamais utiliser en production.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
