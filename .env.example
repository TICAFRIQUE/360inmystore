APP_NAME=360inmystore
APP_ENV=local
APP_KEY=
# true en local uniquement — repasser à false en production (fuite de traces
# d'erreur détaillées sinon, voir DEPLOIEMENT.md).
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=360inmystore
DB_USERNAME=root
DB_PASSWORD=

# Chemin complet vers mysqldump.exe/mysql.exe, uniquement si la sauvegarde/
# restauration (Paramètres) échoue avec "introuvable" malgré l'auto-détection
# du dossier Laragon standard — ex.
# C:\laragon\bin\mysql\mysql-8.0.30-winx64\bin\mysqldump.exe
MYSQLDUMP_PATH=
MYSQL_PATH=

# Nom d'utilisateur exempté du blocage d'abonnement (voir config/abonnement.php)
# — laisser vide sur une installation cliente normale, réservé au support éditeur.
ABONNEMENT_DEVELOPPEUR_USERNAME=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# false en local (HTTP) — forcer à true en production (site servi en HTTPS),
# sinon le cookie de session peut être transmis en clair.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
